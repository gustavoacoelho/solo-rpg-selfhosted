# Chave de API da Anthropic: https://console.anthropic.com
# Cada turno é cobrado por uso (veja "Custo" no README).
ANTHROPIC_API_KEY=

# Senha única de acesso ao app.
APP_PASSWORD=troque-isto

# Segredo para assinar o cookie de sessão (qualquer string longa aleatória).
# Gere com:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Quem o jogador controla. Entra nas regras da mesa, no rótulo dos turnos e no título.
CHARACTER_NAME=Aventureiro
# Título da campanha (padrão: "Campanha de <CHARACTER_NAME>").
CAMPAIGN_TITLE=

# Galerias de retratos, separadas por vírgula. Uma de cenas é sempre incluída.
# Padrão: só o personagem.
PORTRAIT_GALLERIES=

# Diretório de dados da campanha (cânone, histórico, banco).
CAMPAIGN_DIR=./campanha

# Quantos turnos recentes vão inteiros no contexto de cada jogada.
CONTEXT_WINDOW_TURNS=15

# Modelo. "opus" usa o Opus mais recente; "sonnet" sai mais barato.
MODEL=opus
